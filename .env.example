# Application
APP_NAME=GeoBusiness Intelligence Studio
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CONTACT_EMAIL=https://github.com/FaramarzKowsari/geo-business-intelligence-studio
PUBLIC_BASE_URL=
REQUEST_TIMEOUT_SECONDS=30

# OpenStreetMap endpoints are configurable so they can be switched without a code update.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Safeguards for community-funded OpenStreetMap services.
NOMINATIM_MIN_INTERVAL_SECONDS=1.1
OVERPASS_MIN_INTERVAL_SECONDS=1.0
GEOCODE_CACHE_TTL_SECONDS=604800
GEOCODE_STALE_TTL_SECONDS=2592000
OSM_SEARCH_CACHE_TTL_SECONDS=900
OSM_SEARCH_STALE_TTL_SECONDS=3600
PUBLIC_OSM_REQUESTS_PER_MINUTE=10
PUBLIC_OSM_MAX_RECORDS=50
PUBLIC_OSM_MAX_RADIUS_M=25000
PUBLIC_OSM_ENABLED=true

# Optional official Google Places API (New)
GOOGLE_PLACES_API_KEY=
GOOGLE_SEARCH_CACHE_TTL_SECONDS=300

# Optional AI: none | ollama | openai_compatible
AI_PROVIDER=none
AI_MODEL=qwen3:4b
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
