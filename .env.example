# Application
APP_NAME=GeoBusiness Intelligence Studio
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CONTACT_EMAIL=https://github.com/FaramarzKowsari/geo-business-intelligence-studio
REQUEST_TIMEOUT_SECONDS=30

# Public OpenStreetMap services. For production/high volume, run or purchase dedicated services.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Optional official Google Places API (New)
GOOGLE_PLACES_API_KEY=

# Optional AI: none | ollama | openai_compatible
AI_PROVIDER=none
AI_MODEL=qwen3:4b
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
